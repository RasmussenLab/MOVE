# OS and editor files
.DS_Store
.vscode/
.idea/

# Jupyter NB checkpoints
.ipynb_checkpoints

# Python compiled bytecode
__pycache__/
*.py[cod]

# NumPy/PyTorch binary files
*.npy
*.pt

# Distribution and packaging files
build/
dist/
*.egg-info/

# Testing
.pytest_cache/

# Virtual environment
venv/
.venv/

# Logs and outputs of MOVE runs
outputs/
logs/
*.log
/interim_data/
/results/

# docs files
docs/build/
docs/source/_templates/

# Tutorial files: keep configs, input data, notebooks and README; ignore the
# rest (e.g., interim data and results generated when running the tutorial)
tutorial/*
!tutorial/config/
!tutorial/data/
!tutorial/maize/
tutorial/maize/*
!tutorial/maize/maize_dataset.py
!tutorial/notebooks/
tutorial/notebooks/*
!tutorial/notebooks/*.ipynb
!tutorial/notebooks/README.md
!tutorial/README.md
